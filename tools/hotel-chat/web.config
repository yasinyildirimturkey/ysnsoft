<?xml version="1.0" encoding="utf-8"?>
<!-- IIS + iisnode altında çalıştırmak için. Başka bir barındırmada bu dosya kullanılmaz. -->
<configuration>
  <system.webServer>
    <modules>
      <remove name="WebDAVModule"/>
    </modules>
    <handlers>
      <remove name="WebDAV"/>
      <!-- responseBufferLimit=0: sohbet cevabı (SSE) parça parça akabilsin diye IIS tamponlaması kapatılır. -->
      <add name="iisnode" path="iis-start.cjs" verb="*" modules="iisnode" responseBufferLimit="0"/>
    </handlers>
    <rewrite>
      <rules>
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:0}" redirectType="Permanent" />
        </rule>
        <!-- Her istek uygulamaya gider; .env, data/ ve kaynak dosyalar IIS tarafından asla doğrudan sunulmaz. -->
        <rule name="App">
          <action type="Rewrite" url="iis-start.cjs"/>
        </rule>
      </rules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
    <directoryBrowse enabled="false"/>
    <!-- Uygulamanın JSON hata yanıtları IIS hata sayfasıyla değiştirilmesin. -->
    <httpErrors existingResponse="PassThrough" />
    <!--
      nodeProcessCountPerApplication=1: hız sınırı bellekte, veritabanı tek dosya; tek işlem şart.
      flushResponse: SSE parçaları bekletilmeden gönderilir.
      enableXFF: gerçek istemci adresi X-Forwarded-For ile uygulamaya iletilir (TRUST_PROXY=true ile).
      Yeniden başlatmak için web.config dosyasına dokunmak yeterlidir.
    -->
    <iisnode
      nodeProcessCountPerApplication="1"
      flushResponse="true"
      enableXFF="true"
      loggingEnabled="true"
      logDirectory="iisnode"
      maxNamedPipeConnectionRetry="250"
      namedPipeConnectionRetryDelay="350"
      watchedFiles="web.config"/>
  </system.webServer>
</configuration>
