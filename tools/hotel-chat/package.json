{
  "name": "hotel-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run build:widget && tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json && npm run build:widget",
    "build:widget": "esbuild widget/widget.ts --bundle --minify --format=iife --target=es2019 --outfile=public/widget.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "npm run build:widget && tsx --env-file=demo.env src/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
