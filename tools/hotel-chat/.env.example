# --- Sunucu ---
PORT=8787
# Ters vekil (nginx/IIS) arkasındaysa true yapın; aksi halde IP hız sınırı vekilin IP'sini görür.
TRUST_PROXY=false
DATA_DIR=./data
HOTELS_DIR=./hotels

# --- Claude API ---
# "anthropic" = gerçek API, "demo" = anahtarsız, kural tabanlı sahte model (yalnızca geliştirme)
LLM_MODE=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high (boş bırakılırsa modelin varsayılanı). Sohbet için low yeterli.
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=4000
# "default" = model güvenlik nedeniyle reddederse API yedek modele düşer. Kapatmak için boş bırakın.
ANTHROPIC_REFUSAL_FALLBACK=default

# --- Kötüye kullanım sınırları ---
MAX_MESSAGE_CHARS=1000
RATE_IP_PER_MINUTE=20
RATE_IP_PER_DAY=300
RATE_SESSION_PER_MINUTE=8
MAX_TURNS_PER_SESSION=40
MAX_TOOL_CALLS_PER_SESSION=20
MAX_TOOL_ROUNDS_PER_TURN=4

# --- E-posta (insana devir) ---
# SMTP_HOST boşsa e-posta gönderilmez, yalnızca sunucu loguna yazılır (geliştirme).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Otel Asistanı <no-reply@example.com>"

# --- Otel bazlı gizli anahtarlar ---
# hotel.json içindeki pms.secretsEnvPrefix değeri önek olarak kullanılır.
# Ya API anahtarı ya da kullanıcı kodu + parola verin.
# ELEKTRA_DEMO_API_KEY=
# ELEKTRA_DEMO_USERCODE=
# ELEKTRA_DEMO_PASSWORD=

# --- Yönetim paneli (/admin) ---
# En az 16 karakter. Boşsa panel kapalıdır. Üretmek için: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=
# Panelde tahmini maliyet için 1 milyon token başına USD (kullandığınız modelin fiyatı).
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# --- Uyarılar ---
# PMS arızası, model hatası ve bütçe aşımında e-posta gidecek adres (15 dakikada en fazla bir kez).
OPS_ALERT_EMAIL=

# --- WhatsApp Business (Cloud API) ---
# Üçü de doluysa ve bir otelin hotel.json dosyasında "whatsapp" bölümü varsa /webhooks/whatsapp açılır.
# VERIFY_TOKEN: Meta panelinde webhook'u doğrularken sizin belirlediğiniz değer.
# APP_SECRET: Meta uygulamasının "App Secret" değeri (bildirim imzası bununla doğrulanır).
# API_VERSION: Meta panelinde görünen güncel Graph API sürümü, ör. v21.0 biçiminde.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=
# Otel başına erişim anahtarı: hotel.json → whatsapp.secretsEnvPrefix + _TOKEN
# WA_PATIKOY_TOKEN=

# Devir anlık bildirimi: hotel.json → handoff.notifyWebhookEnv içinde adı yazan değişken, ör.
# PATIKOY_HANDOFF_WEBHOOK=https://hooks.slack.com/services/...
