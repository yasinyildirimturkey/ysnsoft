# --- Sunucu ---
PORT=8787
# Ters vekil (nginx/IIS) arkasındaysa true yapın; aksi halde IP hız sınırı vekilin IP'sini görür.
TRUST_PROXY=false
DATA_DIR=./data
HOTELS_DIR=./hotels

# --- Claude API ---
# "anthropic" = gerçek API, "demo" = anahtarsız, kural tabanlı sahte model (yalnızca geliştirme)
LLM_MODE=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high (boş bırakılırsa modelin varsayılanı). Sohbet için low yeterli.
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=4000
# "default" = model güvenlik nedeniyle reddederse API yedek modele düşer. Kapatmak için boş bırakın.
ANTHROPIC_REFUSAL_FALLBACK=default

# --- Kötüye kullanım sınırları ---
MAX_MESSAGE_CHARS=1000
RATE_IP_PER_MINUTE=20
RATE_IP_PER_DAY=300
RATE_SESSION_PER_MINUTE=8
MAX_TURNS_PER_SESSION=40
MAX_TOOL_CALLS_PER_SESSION=20
MAX_TOOL_ROUNDS_PER_TURN=4

# --- E-posta (insana devir) ---
# SMTP_HOST boşsa e-posta gönderilmez, yalnızca sunucu loguna yazılır (geliştirme).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Otel Asistanı <no-reply@example.com>"

# --- Otel bazlı gizli anahtarlar ---
# hotel.json içindeki pms.secretsEnvPrefix değeri önek olarak kullanılır.
# Ya API anahtarı ya da kullanıcı kodu + parola verin.
# ELEKTRA_DEMO_API_KEY=
# ELEKTRA_DEMO_USERCODE=
# ELEKTRA_DEMO_PASSWORD=
