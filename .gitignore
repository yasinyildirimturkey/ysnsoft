# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# deploy packages
/_deploy/

# admin accounts (password hashes) and audit log live only on the server
/data/admin-users.json
/data/admin-users.json.*.tmp
/data/admin-audit.log

# live data (inbound leads contain personal data; site list is edited on the server)
/data/leads.json
/data/appointments.json
/data/invoices.json
/data/system-settings.json
/data/testimonials.json
/data/offer-requests.json
/data/customer-care.json
/data/sites.json
/data/mail-log.jsonl
/data/scheduler/
/data/push-vapid.json
/data/push-subs.json
/data/notifications.json
/data/notif-seen.json
/data/last-crash.json
