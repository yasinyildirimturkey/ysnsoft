<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <modules>
      <remove name="WebDAVModule"/>
    </modules>
    <handlers>
      <remove name="WebDAV"/>
      <add name="iisnode" path="start.js" verb="*" modules="iisnode"/>
    </handlers>
    <rewrite>
      <rules>
        <!-- 1. Enforce HTTPS (Exclude ACME challenge for SSL auto-renewals) -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:0}" redirectType="Permanent" />
        </rule>

        <!-- 2. Next.js Dynamic Content Rewrite -->
        <rule name="DynamicContent">
          <action type="Rewrite" url="start.js"/>
        </rule>
      </rules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
    <directoryBrowse enabled="false"/>
    <iisnode
      nodeProcessCountPerApplication="1"
      maxNamedPipeConnectionRetry="250"
      namedPipeConnectionRetryDelay="350"
      maxNamedPipeConnectionPoolSize="512"
      watchedFiles="web.config"/>
  </system.webServer>
</configuration>
